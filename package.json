{
  "name": "reflecta-mono",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev:gui": "cd apps/electron && bun run dev",
    "dev:cli": "cd apps/cli && bun run dev",
    "test": "bun run --filter '*' test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.19.11",
    "@typescript/native-preview": "^7.0.0-dev.20260616.1",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "sass": "^1.101.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3"
  }
}
