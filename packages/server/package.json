{
  "name": "@reflecta/server",
  "version": "1.3.22",
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "import": "./src/runtime/index.ts",
      "require": "./src/runtime/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest --passWithNoTests",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@lancedb/lancedb": "0.33.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "libsql": "^0.5.29",
    "nanoid": "^6.0.1",
    "node-llama-cpp": "^3.19.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
