{
  "name": "@reflecta/electron",
  "version": "1.3.14",
  "description": "Reflecta Electron application",
  "homepage": "https://github.com/electron-vite/vite-plugin-electron",
  "author": "com.acnoo.reflecta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Floribunda1/reflecta.git",
    "directory": "apps/electron"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsgo --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsgo --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test": "bun run test:main && bun run test:renderer",
    "test:main": "vitest run --root . src/main",
    "test:renderer": "vitest run",
    "start": "electron .",
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "clean:dist": "rm -rf dist",
    "feature:check": "bun run scripts/e2e-features.ts check",
    "feature:diff": "bun run scripts/e2e-features.ts diff",
    "test:e2e": "bun run feature:check && bun run build && playwright test --forbid-only",
    "test:e2e:acceptance": "bun run feature:check && bun run build && playwright test --forbid-only --project acceptance",
    "test:e2e:regression": "bun run build && playwright test --forbid-only --project regression",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "postinstall": "electron-builder install-app-deps",
    "build:sparkle": "bash scripts/build-sparkle-updater.sh",
    "build:unpack": "bun run clean:dist && bun run build && electron-builder --dir",
    "build:win": "bun run clean:dist && bun run build && electron-builder --win",
    "build:mac": "bun run build:sparkle && bun run clean:dist && bun run build && electron-builder --mac --arm64",
    "build:linux": "bun run clean:dist && bun run build && electron-builder --linux"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@lancedb/lancedb": "0.33.0",
    "apache-arrow": "18.1.0",
    "better-sqlite3": "^13.0.2",
    "libsql": "^0.5.29",
    "node-llama-cpp": "^3.19.1",
    "pi-web-access": "0.18.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@oxc-project/runtime": "^0.143.0",
    "@playwright/test": "^1.62.1",
    "@reflecta/server": "workspace:*",
    "@reflecta/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ahooks": "^3.9.7",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-ipc-decorator": "1.0.1",
    "electron-log": "^5.4.4",
    "happy-dom": "^20.11.1",
    "isbinaryfile": "^6.0.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.28.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.11.2",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "unpdf": "^1.8.0",
    "vite": "^8.2.0",
    "vite-plugin-electron": "1.1.1",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "productName": "Reflecta"
}
