{
  "name": "@reflecta/electron",
  "version": "2.0.1",
  "description": "Reflecta Electron application",
  "homepage": "https://github.com/electron-vite/vite-plugin-electron",
  "author": "com.acnoo.reflecta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Floribunda1/reflecta.git",
    "directory": "apps/electron"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test": "bun run test:main && bun run test:renderer",
    "test:main": "vitest run --root . src/main",
    "test:renderer": "vitest run",
    "start": "electron .",
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "clean:dist": "rm -rf dist",
    "feature:check": "bun run scripts/e2e-features.ts check",
    "feature:diff": "bun run scripts/e2e-features.ts diff",
    "test:e2e": "bun run feature:check && bun run build && playwright test --forbid-only",
    "test:e2e:acceptance": "bun run feature:check && bun run build && playwright test --forbid-only --project acceptance",
    "test:e2e:regression": "bun run build && playwright test --forbid-only --project regression",
    "test:e2e:integration": "bun run build && playwright test --forbid-only --project integration",
    "test:e2e:benchmark": "bun run build && playwright test --forbid-only --project benchmark",
    "bench:report": "playwright test --forbid-only --project benchmark --reporter=line",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "postinstall": "electron-builder install-app-deps",
    "build:sparkle": "bash scripts/build-sparkle-updater.sh",
    "build:unpack": "bun run clean:dist && bun run build && electron-builder --dir",
    "build:win": "bun run clean:dist && bun run build && electron-builder --win",
    "build:mac": "bun run build:sparkle && bun run clean:dist && bun run build && electron-builder --mac --arm64",
    "build:linux": "bun run clean:dist && bun run build && electron-builder --linux"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@effect/atom-react": "4.0.0-beta.107",
    "@lancedb/lancedb": "0.37.1",
    "apache-arrow": "21.2.0",
    "better-sqlite3": "^13.0.3",
    "effect": "4.0.0-rc.112",
    "effect-query": "1.0.0",
    "electron-effect-rpc": "0.10.0",
    "libsql": "^0.5.29",
    "motion": "^13.1.1",
    "node-llama-cpp": "^3.20.0",
    "pi-web-access": "0.25.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@oxc-project/runtime": "^0.147.0",
    "@playwright/test": "^1.62.1",
    "@reflecta/server": "workspace:*",
    "@reflecta/shared": "workspace:*",
    "@reflecta/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.6",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "ahooks": "^3.9.7",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "happy-dom": "^20.11.8",
    "isbinaryfile": "^6.0.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.34.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "unpdf": "^1.8.1",
    "vite": "^8.2.2",
    "vite-plugin-electron": "1.1.1",
    "vitest": "^4.1.11"
  },
  "productName": "Reflecta"
}
