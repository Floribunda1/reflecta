{
  "name": "@reflecta/electron",
  "version": "1.0.0",
  "description": "Reflecta Electron application",
  "homepage": "https://github.com/electron-vite/vite-plugin-electron",
  "author": "example.com",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsgo --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsgo --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test": "bun run test:main && bun run test:renderer",
    "test:main": "vitest run --root . src/main",
    "test:renderer": "vitest run",
    "start": "electron .",
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux"
  },
