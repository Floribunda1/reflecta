{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/build/**/*",
    "**/dist/**/*",
    "**/out/**/*",
    "**/resources/**/*",
    "**/node_modules/**/*"
  ],
  "rules": {
    "typescript/no-explicit-any": "error"
  },
  "env": {
    "builtin": true
  }
}
