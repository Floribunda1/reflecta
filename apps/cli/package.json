{
  "name": "@reflecta/cli",
  "version": "2.0.5",
  "description": "Reflecta CLI — scriptable access to your local knowledge base",
  "bin": {
    "reflecta": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "REFLECTA_CLI_BUILD_KIND=source tsdown --watch",
    "start": "node ./dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@lancedb/lancedb": "0.37.1",
    "@reflecta/server": "workspace:*",
    "@reflecta/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-rc.112",
    "libsql": "^0.5.29",
    "node-llama-cpp": "^3.20.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
