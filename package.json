{
  "name": "reflecta-mono",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev:gui": "cd apps/electron && REFLECTA_PROFILE=dev bun run dev",
    "prod:gui": "cd apps/electron && REFLECTA_PROFILE=prod bun run dev",
    "dev:cli": "cd apps/cli && REFLECTA_PROFILE=dev bun run dev",
    "prod:cli": "cd apps/cli && REFLECTA_PROFILE=prod bun run dev",
    "db:migrate:dev": "bun run apps/cli/scripts/dev-db.ts migrate",
    "db:reset:dev": "bun run apps/cli/scripts/dev-db.ts reset",
    "db:push:dev": "bun run apps/cli/scripts/dev-db.ts push",
    "db:seed:dev": "bun run apps/cli/scripts/dev-db.ts seed",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --cwd apps/electron test:e2e",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.19.11",
    "@typescript/native-preview": "^7.0.0-dev.20260616.1",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "sass": "^1.101.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3"
  }
}
