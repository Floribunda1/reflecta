{
  "name": "@reflecta/server",
  "version": "1.3.12",
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "import": "./src/runtime/index.ts",
      "require": "./src/runtime/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest --passWithNoTests",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@lancedb/lancedb": "0.31.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "libsql": "^0.5.29",
    "nanoid": "^5.1.7",
    "node-llama-cpp": "^3.18.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
