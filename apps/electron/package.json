{
  "name": "@reflecta/electron",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "homepage": "https://electron-vite.org",
  "author": "example.com",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "bun run typecheck && electron-vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@libsql/client": "^0.17.2",
    "ajv": "^8.18.0",
    "drizzle-orm": "^0.45.2",
    "electron-ipc-decorator": "1.0.0",
    "electron-updater": "^6.7.3",
    "eventemitter3": "^5.0.4",
    "lodash-es": "^4.18.1",
    "nanoid": "^5.1.7",
    "openai": "^6.34.0",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@antv/g6": "^5.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@emotion/css": "^11.13.5",
    "@floating-ui/dom": "^1.6.13",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/vue-query": "^5.96.2",
    "@types/lodash-es": "^4.17.12",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vueuse/core": "^14.2.1",
    "date-fns": "^4.1.0",
    "electron": "41.1.1",
    "electron-builder": "^26.7.0",
    "electron-vite": "^5.0.0",
    "marked": "^17.0.6",
    "medium-zoom": "^1.1.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "tailwindcss": "^4.2.2",
    "tailwindcss-primeui": "^0.6.1",
    "vditor": "^3.11.2",
    "vue": "^3.5.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "vue-router": "^5.0.4"
  }
}
