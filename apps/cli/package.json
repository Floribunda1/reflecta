{
  "name": "@reflecta/cli",
  "version": "1.3.22",
  "description": "Reflecta CLI — scriptable access to your local knowledge base",
  "bin": {
    "reflecta": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "REFLECTA_CLI_BUILD_KIND=source tsdown --watch",
    "start": "node ./dist/index.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@lancedb/lancedb": "0.33.0",
    "@reflecta/server": "workspace:*",
    "better-sqlite3": "^13.0.2",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "libsql": "^0.5.29",
    "node-llama-cpp": "^3.19.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
